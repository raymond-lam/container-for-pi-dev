#
# Expose the host SSH agent proxy (see the `pi` wrapper) as a Unix socket,
# then run the container command. Without proxy variables this is a plain
# pass-through.
set -eu

if [ -n "${PI_SSH_AGENT_HOST:-}" ] && [ -n "${PI_SSH_AGENT_PORT:-}" ]; then
  mkdir -p /run/pi
  rm -f /run/pi/ssh-agent.sock
  socat "UNIX-LISTEN:/run/pi/ssh-agent.sock,fork,mode=600" \
    "TCP:${PI_SSH_AGENT_HOST}:${PI_SSH_AGENT_PORT}" &
  export SSH_AUTH_SOCK=/run/pi/ssh-agent.sock
fi

exec tini -g -- "$@"
