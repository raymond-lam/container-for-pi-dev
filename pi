# Pi Coding Agent — Docker Wrapper
#
# This script builds (if necessary) and runs the pi coding agent inside a
# Docker container. It forwards just enough host state into the container to
# make the experience seamless without over-sharing credentials:
#
#   • The current working directory → same absolute path (read/write)
#   • Pi's agent state directory    → same absolute path (read/write)
#   • Your OpenRouter API key       → injected as an environment variable
#   • Git identity & SSH signing    → rewritten paths + dedicated signing agent
#   • GitHub CLI (gh) auth          → read-only mount of ~/.config/gh
#   • VS Code bridge                → host.docker.internal + extension mount
#
# The script also supports the pi0.pi-vscode extension. Set the VS Code
# setting `pi-vscode.path` to this script's absolute path.
#
# Requirements
#   • Docker
#   • macOS Keychain with an item for openrouter.ai (used for the API key)
#   • git (optional — if missing, git identity and signing mounts are skipped)
#
# Usage
#   ./pi [any pi subcommands or flags]
#
set -euo pipefail

SCRIPT_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
IMAGE=localhost/pi-sandbox
PLATFORM="$(uname -s)"
APP_UID="$(id -u)"
APP_GID="$(id -g)"

if [[ "$APP_UID" -eq 0 || "$APP_GID" -eq 0 ]]; then
  echo "Error: refusing to run as root; the container user mirrors the host UID/GID." >&2
  exit 1
fi

# ------------------------------------------------------------------------
# Build the image
# ------------------------------------------------------------------------
# A fresh build is triggered every invocation. Docker's layer cache makes
# this essentially free when nothing has changed.
# Build output goes to stderr so `pi --mode rpc` stdout stays parseable.
# The container user is built with the invoking user's UID/GID so bind-mounted
# files keep their ownership and remain writable on native Linux. This cannot
# be hard-coded to 1000: Docker bind mounts preserve numeric ownership, so a
# host user with a different UID/GID would be unable to write the mounted files.
docker build \
  --build-arg "APP_UID=$APP_UID" \
  --build-arg "APP_GID=$APP_GID" \
  -f Containerfile -t "$IMAGE" "$SCRIPT_DIR" >&2

# ------------------------------------------------------------------------
# API key
# ------------------------------------------------------------------------
# Prefer OPENROUTER_API_KEY from the environment (Linux/Podman/CI). Otherwise
# fall back to the macOS Keychain.
# ------------------------------------------------------------------------
mkdir -p "${HOME}/.pi/agent"
if [[ -z "${OPENROUTER_API_KEY:-}" ]] && command -v security >/dev/null 2>&1; then
  OPENROUTER_API_KEY="$(security find-generic-password -s openrouter.ai -a api-key -w 2>/dev/null || true)"
fi
if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
  echo "Error: set OPENROUTER_API_KEY, or store it in macOS Keychain (service openrouter.ai, account api-key)." >&2
  exit 1
fi
export OPENROUTER_API_KEY

DOCKER_ARGS=(
  run --rm
  --cap-drop=ALL
  --security-opt=no-new-privileges
  --pids-limit="${PI_PIDS_LIMIT:-512}"
  --memory="${PI_MEMORY:-4g}"
  --cpus="${PI_CPUS:-2}"
  --ulimit "nofile=${PI_NOFILE_SOFT:-4096}:${PI_NOFILE_HARD:-8192}"
  -e OPENROUTER_API_KEY
  -v "$PWD:$PWD"
  -w "$PWD"
  -v "${HOME}/.pi/agent:${HOME}/.pi/agent"
  -e "PI_CODING_AGENT_DIR=${HOME}/.pi/agent"
)

# Use host.docker.internal on both platforms instead of host networking.
# On Linux, host-gateway resolves it to the Docker bridge gateway. Host
# services are still reachable, but the container no longer shares the host
# network namespace (and therefore cannot reach host loopback-only services).
HOST_ALIAS=host.docker.internal
# Never bind proxies to every interface. Loopback is the safe default for
# Docker Desktop, whose host.docker.internal forwards to host loopback. On
# native Linux the container reaches the host through the Docker bridge
# gateway instead, so use that address when it can be determined. If it
# cannot, SOCAT_BIND stays empty and callers fail closed.
SOCAT_BIND=127.0.0.1
if [[ "$PLATFORM" == "Linux" ]]; then
  DOCKER_ARGS+=(--add-host=host.docker.internal:host-gateway)
  DOCKER_GATEWAY="$(docker network inspect bridge \
    --format '{{(index .IPAM.Config 0).Gateway}}' 2>/dev/null || true)"
  if [[ -n "$DOCKER_GATEWAY" ]]; then
    SOCAT_BIND="$DOCKER_GATEWAY"
  else
    SOCAT_BIND=""
  fi
fi

# ------------------------------------------------------------------------
# Process cleanup
# ------------------------------------------------------------------------
# Install the trap before starting any background proxies.
# ------------------------------------------------------------------------
GIT_CONFIG_DIR=$(mktemp -d)
BRIDGE_RELAY_PID=""
SIGNING_AGENT_DIR=""
SIGNING_AGENT_SOCKET=""
SIGNING_AGENT_PID=""
SSH_AGENT_PROXY_PID=""

kill_tree() {
  local TARGET_PID="${1:-}"
  [[ -n "$TARGET_PID" ]] || return 0
  if command -v pkill >/dev/null 2>&1; then
    pkill -TERM -P "$TARGET_PID" 2>/dev/null || true
  fi
  kill -TERM "$TARGET_PID" 2>/dev/null || true
  wait "$TARGET_PID" 2>/dev/null || true
}

cleanup() {
  trap - EXIT INT TERM HUP
  kill_tree "$BRIDGE_RELAY_PID"
  kill_tree "$SSH_AGENT_PROXY_PID"
  kill_tree "$SIGNING_AGENT_PID"
  rm -rf "$GIT_CONFIG_DIR" "$SIGNING_AGENT_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

# ------------------------------------------------------------------------
# VS Code bridge
# ------------------------------------------------------------------------
# The pi0.pi-vscode extension exposes a localhost HTTP bridge and passes its
# URL, token, and terminal ID to pi. Rewrite loopback to the shared host
# alias, and mount the installed extension at its host path so pi can load
# the bridge.
# ------------------------------------------------------------------------
if [[ -n "${PI_VSCODE_BRIDGE_URL:-}" ]]; then
  # On Linux the bridge no longer shares the host network namespace. If the
  # extension advertises a host-loopback URL, relay it through a small TCP
  # proxy bound to the Docker bridge gateway (still protected by the bridge
  # token). macOS/Windows Docker already maps host.docker.internal for us.
  if [[ "$PLATFORM" == "Linux" && "$PI_VSCODE_BRIDGE_URL" =~ ^(https?)://(127\.0\.0\.1|localhost):([0-9]+)(.*)$ ]]; then
    BRIDGE_SCHEME="${BASH_REMATCH[1]}"
    BRIDGE_HOST_PORT="${BASH_REMATCH[3]}"
    BRIDGE_REST="${BASH_REMATCH[4]}"
    BRIDGE_RELAY_PORT="$((RANDOM % 16384 + 49152))"
    if [[ -z "$SOCAT_BIND" ]]; then
      echo "Error: could not determine a container-reachable bind address for the VS Code bridge relay." >&2
      exit 1
    fi
    socat "TCP-LISTEN:$BRIDGE_RELAY_PORT,bind=$SOCAT_BIND,reuseaddr,fork" \
      "TCP:127.0.0.1:$BRIDGE_HOST_PORT" </dev/null >/dev/null 2>&1 &
    BRIDGE_RELAY_PID=$!
    sleep 0.1
    if ! kill -0 "$BRIDGE_RELAY_PID" 2>/dev/null; then
      echo "Error: could not start the VS Code bridge relay on port $BRIDGE_RELAY_PORT." >&2
      exit 1
    fi
    PI_VSCODE_BRIDGE_URL="$BRIDGE_SCHEME://$HOST_ALIAS:$BRIDGE_RELAY_PORT$BRIDGE_REST"
  else
    PI_VSCODE_BRIDGE_URL="${PI_VSCODE_BRIDGE_URL/127.0.0.1/$HOST_ALIAS}"
    PI_VSCODE_BRIDGE_URL="${PI_VSCODE_BRIDGE_URL/localhost/$HOST_ALIAS}"
  fi
  DOCKER_ARGS+=(-e "PI_VSCODE_BRIDGE_URL=$PI_VSCODE_BRIDGE_URL")
  DOCKER_ARGS+=(-e PI_VSCODE_BRIDGE_TOKEN -e PI_VSCODE_TERMINAL_ID)

  # Mount installed pi0.pi-vscode extension directories at their host paths
  # so the extension's --extension path resolves inside the container.
  for EXT_ROOT in \
    "$HOME/.vscode/extensions" \
    "$HOME/.vscode-server/extensions" \
    "$HOME/.vscode-insiders/extensions" \
    "$HOME/.cursor/extensions" \
    "$HOME/.windsurf/extensions" \
    "$HOME/.positron/extensions"; do
    for EXT_DIR in "$EXT_ROOT"/pi0.pi-vscode-*; do
      [[ -d "$EXT_DIR" ]] && DOCKER_ARGS+=(-v "$EXT_DIR:$EXT_DIR:ro")
    done
  done
fi

# ------------------------------------------------------------------------
# Git configuration
# ------------------------------------------------------------------------
# We do NOT mount ~/.gitconfig directly because it often contains
# platform-specific absolute paths (e.g. /Users/<you>/... on macOS).
# Instead we read the values we need from the host, rewrite the paths for
# the container's filesystem, and generate a brand-new config file.
# ------------------------------------------------------------------------
if command -v git >/dev/null 2>&1; then
  GIT_USER_NAME=$(git config --global user.name)
  GIT_USER_EMAIL=$(git config --global user.email)
  GIT_SIGNING_KEY_PATH=$(git config --global user.signingkey)
  GIT_ALLOWED_SIGNERS_PATH=$(git config --global gpg.ssh.allowedSignersFile)

  # Check signing prerequisites up front. An empty GIT_SIGNING_KEY_PATH means
  # signing is unavailable and must stay disabled in the generated config.
  if [[ -n "$GIT_SIGNING_KEY_PATH" && -f "$GIT_SIGNING_KEY_PATH" ]]; then
    if grep -q -- '-----BEGIN .*PRIVATE KEY-----' "$GIT_SIGNING_KEY_PATH"; then
      echo "Warning: user.signingkey points to a private key; not mounting it or signing commits." >&2
      GIT_SIGNING_KEY_PATH=""
    elif command -v socat >/dev/null 2>&1; then
      # Locate the private key pairing the configured signing key and verify
      # the pair by fingerprint before enabling signing.
      SIGNING_PRIVATE_KEY_PATH=""
      if grep -q -- '-----BEGIN .*PRIVATE KEY-----' "$GIT_SIGNING_KEY_PATH" 2>/dev/null; then
        SIGNING_PRIVATE_KEY_PATH="$GIT_SIGNING_KEY_PATH"
      elif [[ "$GIT_SIGNING_KEY_PATH" == *.pub ]] && \
           grep -q -- '-----BEGIN .*PRIVATE KEY-----' "${GIT_SIGNING_KEY_PATH%.pub}" 2>/dev/null; then
        SIGNING_PRIVATE_KEY_PATH="${GIT_SIGNING_KEY_PATH%.pub}"
      fi

      SIGNING_PUBLIC_KEY_FINGERPRINT=""
      SIGNING_PRIVATE_KEY_FINGERPRINT=""
      if [[ -n "$SIGNING_PRIVATE_KEY_PATH" ]] && command -v ssh-keygen >/dev/null 2>&1; then
        SIGNING_PUBLIC_KEY_FINGERPRINT="$(ssh-keygen -lf "$GIT_SIGNING_KEY_PATH" 2>/dev/null | awk '{print $2}' || true)"
        SIGNING_PRIVATE_KEY_FINGERPRINT="$(ssh-keygen -y -f "$SIGNING_PRIVATE_KEY_PATH" 2>/dev/null | ssh-keygen -lf - 2>/dev/null | awk '{print $2}' || true)"
      fi

      if [[ -n "$SIGNING_PUBLIC_KEY_FINGERPRINT" && -n "$SIGNING_PRIVATE_KEY_FINGERPRINT" && "$SIGNING_PRIVATE_KEY_FINGERPRINT" == "$SIGNING_PUBLIC_KEY_FINGERPRINT" ]]; then
        # Run a fresh, isolated agent holding only the git signing key, rather
        # than forwarding the host's personal agent. The sandbox (and any
        # compromise) can then only ever request signatures with that one key.
        if command -v ssh-agent >/dev/null 2>&1 && command -v ssh-add >/dev/null 2>&1; then
          SIGNING_AGENT_DIR="$(mktemp -d)"
          SIGNING_AGENT_SOCKET="$SIGNING_AGENT_DIR/signing-agent.sock"
          SIGNING_AGENT_VARS="$(ssh-agent -a "$SIGNING_AGENT_SOCKET" 2>/dev/null)"
          SIGNING_AGENT_PID="$(printf '%s\n' "$SIGNING_AGENT_VARS" | sed -n 's/^SSH_AGENT_PID=\([0-9][0-9]*\);.*/\1/p')"
        fi

        if [[ -S "$SIGNING_AGENT_SOCKET" ]] \
           && SSH_AUTH_SOCK="$SIGNING_AGENT_SOCKET" ssh-add "$SIGNING_PRIVATE_KEY_PATH" </dev/null >/dev/null 2>&1; then
          SSH_AGENT_PORT="${PI_SSH_AGENT_PORT:-$((RANDOM % 16384 + 49152))}"
          if [[ -z "$SOCAT_BIND" ]]; then
            echo "Warning: could not determine a container-reachable bind address for the SSH agent proxy; SSH commit signing is disabled." >&2
            GIT_SIGNING_KEY_PATH=""
          else
            socat "TCP-LISTEN:$SSH_AGENT_PORT,bind=$SOCAT_BIND,reuseaddr,fork" "UNIX-CONNECT:$SIGNING_AGENT_SOCKET" </dev/null >/dev/null 2>&1 &
            SSH_AGENT_PROXY_PID=$!
            DOCKER_ARGS+=(
              -e "PI_SSH_AGENT_HOST=$HOST_ALIAS"
              -e "PI_SSH_AGENT_PORT=$SSH_AGENT_PORT"
              -v "$GIT_SIGNING_KEY_PATH:/home/pi/.ssh/git-signing.pub:ro"
            )
          fi
        else
          echo "Warning: could not start a dedicated signing agent; SSH commit signing is disabled." >&2
          GIT_SIGNING_KEY_PATH=""
        fi
      else
        echo "Warning: could not confirm a private key for 'user.signingkey'; SSH commit signing is disabled." >&2
        GIT_SIGNING_KEY_PATH=""
      fi
    else
      echo "Warning: socat unavailable; SSH commit signing is disabled." >&2
      GIT_SIGNING_KEY_PATH=""
    fi
  fi

  # Use git itself so values containing newlines or special characters are
  # escaped instead of being interpolated into the config file.
  : > "$GIT_CONFIG_DIR/gitconfig"
  if [[ -n "$GIT_USER_NAME" ]]; then
    git config --file "$GIT_CONFIG_DIR/gitconfig" user.name "$GIT_USER_NAME"
  fi
  if [[ -n "$GIT_USER_EMAIL" ]]; then
    git config --file "$GIT_CONFIG_DIR/gitconfig" user.email "$GIT_USER_EMAIL"
  fi
  # The signingkey line below belongs to [user]; ensure the section exists even
  # when the host has no name/email configured.
  if [[ -n "$GIT_SIGNING_KEY_PATH" ]] && ! grep -q '^\[user\]' "$GIT_CONFIG_DIR/gitconfig"; then
    printf '[user]\n' >> "$GIT_CONFIG_DIR/gitconfig"
  fi
  if [[ -n "$GIT_SIGNING_KEY_PATH" ]]; then
    cat >> "$GIT_CONFIG_DIR/gitconfig" <<EOF
  signingkey = /home/pi/.ssh/git-signing.pub
[gpg]
  format = ssh
[commit]
  gpgsign = true
[tag]
  gpgsign = true
[gpg "ssh"]
  allowedSignersFile = /home/pi/.config/git/allowed_signers
EOF
    if [[ -n "$GIT_ALLOWED_SIGNERS_PATH" && -f "$GIT_ALLOWED_SIGNERS_PATH" ]]; then
      DOCKER_ARGS+=(-v "$GIT_ALLOWED_SIGNERS_PATH:/home/pi/.config/git/allowed_signers:ro")
    fi
  else
    cat >> "$GIT_CONFIG_DIR/gitconfig" <<EOF
[commit]
  gpgsign = false
[tag]
  gpgsign = false
EOF
  fi

  # The generated config lives in a temporary directory and is deleted on
  # exit, so mounting it writable is safe. It lets tools such as
  # `gh auth setup-git` update the in-container config without failing.
  DOCKER_ARGS+=(-v "$GIT_CONFIG_DIR/gitconfig:/home/pi/.gitconfig")
fi

# ------------------------------------------------------------------------
# GitHub CLI authentication
# ------------------------------------------------------------------------
# We mount ~/.config/gh for settings, but on macOS the actual OAuth token
# is stored in the login keychain — invisible to the container. To make
# `gh` commands work seamlessly, we also try to read the active token from
# the host via `gh auth token` and inject it as GH_TOKEN. Inside the
# container `gh` prefers GH_TOKEN over the keychain.
# ------------------------------------------------------------------------
# Only mount config.yml. hosts.yml contains plaintext OAuth tokens on Linux
# (and possibly credentials for multiple hosts); GH_TOKEN is already injected.
if [[ -f "$HOME/.config/gh/config.yml" ]]; then
  DOCKER_ARGS+=(-v "$HOME/.config/gh/config.yml:/home/pi/.config/gh/config.yml:ro")
fi

if command -v gh >/dev/null 2>&1; then
  GH_TOKEN="$(gh auth token)"
  if [[ -n "$GH_TOKEN" ]]; then
    export GH_TOKEN
    DOCKER_ARGS+=(-e GH_TOKEN)

    # Teach git to authenticate HTTPS GitHub operations with GH_TOKEN via the
    # gh credential helper. This makes `git push`/`fetch` work out of the box
    # and avoids requiring `gh auth setup-git` inside the container. The empty
    # helper line resets any inherited helpers before adding gh's.
    if [[ -f "$GIT_CONFIG_DIR/gitconfig" ]]; then
      cat >> "$GIT_CONFIG_DIR/gitconfig" <<'EOF'
[credential "https://github.com"]
  helper =
  helper = !gh auth git-credential
EOF
    fi
  fi
fi

# ------------------------------------------------------------------------
# TTY / interactive detection
# ------------------------------------------------------------------------
# Attach stdin when it looks like a real stream so pi can read prompts.
if [[ -t 0 || -p /dev/stdin || -f /dev/stdin ]]; then
  DOCKER_ARGS+=(-i)
fi

# Allocate a pseudo-TTY only when both stdout and stderr are terminals.
# This keeps colours, progress bars, and line editing working correctly.
if [[ -t 1 && -t 2 ]]; then
  DOCKER_ARGS+=(-t)
fi

# ------------------------------------------------------------------------
# Launch
# ------------------------------------------------------------------------
# Run docker as a child rather than exec'ing it so the EXIT trap fires and
# removes the temporary git config and shuts down the agent proxy.
docker "${DOCKER_ARGS[@]}" "$IMAGE" pi "$@"
